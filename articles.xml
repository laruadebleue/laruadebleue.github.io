---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
<title>{{ site.title | xml_escape }} · Articles</title>
<link>{{ '/' | absolute_url }}</link>
<description>Les articles de {{ site.title | xml_escape }}, avec le texte du post Facebook</description>
<language>fr-FR</language>
{% for post in site.posts limit: 10 %}
<item>
<title>{{ post.title | xml_escape }}</title>
<description>{{ site.signe_breve }} {{ post.title | xml_escape }}{% if post.chapeau %}

{{ post.chapeau | strip_html | strip | xml_escape }}{% endif %}</description>
<link>{{ post.url | absolute_url }}</link>
<guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
<pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
</item>{% endfor %}
</channel>
</rss>
