---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
<title>{{ site.title | xml_escape }} · Brèves</title>
<link>{{ '/breves/' | absolute_url }}</link>
<description>Les brèves de {{ site.title | xml_escape }}</description>
<language>fr-FR</language>
{% assign breves = site.breves | sort: "date" | reverse %}{% for breve in breves limit: 20 %}{% assign texte = breve.content | markdownify | strip_html | strip %}
<item>
<title>{{ texte | truncate: 90 | xml_escape }}</title>
<description>{{ site.signe_breve }} {{ texte | xml_escape }}</description>
<link>{{ '/breves/' | absolute_url }}#b{{ breve.date | date: '%Y%m%d%H%M' }}</link>
<guid isPermaLink="false">breve-{{ breve.date | date: '%Y%m%d%H%M' }}</guid>
<pubDate>{{ breve.date | date_to_rfc822 }}</pubDate>
</item>{% endfor %}
</channel>
</rss>
